# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never commit any variant (secrets!)
.env
.env.*
.env*.local
!.env.example

# log files
logs/
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# User data storage (contains sensitive information)
# Must be /data/* and not /data/ — git will not re-include a file whose parent
# directory is excluded, so with /data/ the exceptions below are silently
# ignored. That is how data/productBarcodes.ts went missing and broke the build.
/data/*
# Exceptions below are needed for the build
!/data/productTranslations.ts
!/data/productTranslationsRu.ts
!/data/productConfig.ts
!/data/productBarcodes.ts
!/data/product22LocalizedCopy.ts
!/data/product23LocalizedCopy.ts

# Customer-specific protocols / PII (keep in ~/Documents/genosys-customer-protocols/)
/docs/customers/

# Database files
*.db
*.sqlite
*.sqlite3

# Prisma
/lib/generated/prisma
# prisma/migrations/ is now tracked — it's the source of truth for `prisma migrate deploy`
# in the Vercel build. See docs/DEPLOY_MIGRATIONS.md for the full flow.

# Backup files
/backups/
*.backup
*.bak

# Temporary files
*.tmp
*.temp
test.php
index.php
admin.php
*.tar.gz

# cPanel deployment files
cpanel-upload/
genosys-nextjs-app/

# Large files (over 100MB)
# Note: PDF files in public/documents/ are needed for the website
.env.production
.env.production.local
.env.local.backup.*

# Local-only ID extracts (passport no., MRZ, visa UID/file no.) — never push
docs/PERSONAL_PASSPORT.local.md
docs/PERSONAL_VISA.local.md
scripts/.loyalty-launch-sent.json
