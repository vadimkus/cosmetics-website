!/data/productTranslations.ts
!/data/productTranslationsRu.ts

# Database files
*.db
*.sqlite
*.sqlite3

# Prisma
/lib/generated/prisma
/prisma/migrations/

# Backup files
/backups/
*.backup
*.bak

# Temporary files
*.tmp
*.temp
test.php
index.php
admin.php
*.tar.gz

# cPanel deployment files
cpanel-upload/
genosys-nextjs-app/

# Large files (over 100MB)
# Note: PDF files in public/documents/ are needed for the website
.env.production
.env.production.local
.env.local.backup.*
