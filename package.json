{
  "name": "cosmetics-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "PRISMA_CONFIG_PATH=./prisma.config.ts npx prisma generate && node scripts/deploy-setup.js && next build",
    "build:analyze": "ANALYZE=true node scripts/deploy-setup.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "PRISMA_CONFIG_PATH=./prisma.config.ts prisma generate",
    "db:migrate:deploy": "PRISMA_CONFIG_PATH=./prisma.config.ts npx prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate-password-reset": "node scripts/migrate-password-reset-table.js",
    "db:add-payment-fields": "npx tsx scripts/add-payment-fields-to-orders.ts",
    "translate:products": "npx tsx scripts/translate-products-to-russian.ts",
    "deploy:setup": "node scripts/deploy-setup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@google-cloud/translate": "^9.3.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.2.0",
    "@react-oauth/google": "^0.12.2",
    "@sentry/nextjs": "^10.22.0",
    "@types/nodemailer": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.5.0",
    "isomorphic-dompurify": "^2.30.1",
    "logrocket": "^10.1.0",
    "lucide-react": "^0.543.0",
    "next": "^16.0.7",
    "next-intl": "^4.5.5",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "stripe": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.0.7",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "baseline-browser-mapping": "^2.8.32",
    "cssnano": "^7.1.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.7",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
