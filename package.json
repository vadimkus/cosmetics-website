  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-setup.js && next build",
    "build:analyze": "ANALYZE=true node scripts/deploy-setup.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/deploy-setup.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "deploy:setup": "node scripts/deploy-setup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@sentry/nextjs": "^10.17.0",
    "@types/nodemailer": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "logrocket": "^10.1.0",
    "lucide-react": "^0.543.0",
    "next": "^15.5.2",
    "nodemailer": "^7.0.6",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
