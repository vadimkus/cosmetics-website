generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String
  phone              String?
  address            String?
  profilePicture     String?
  isAdmin            Boolean  @default(false)
  canSeePrices       Boolean  @default(true)
  discountType       String?
  discountPercentage Float?
  birthday           String?
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Product {
  id            String   @id @default(cuid())
  productNumber String?  @unique
  name          String
  price         Float
  description   String   @db.Text
  image         String
  category      String
  inStock       Boolean  @default(true)
  size          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        String?
  noDiscount    Boolean  @default(false) // Exclude from discount calculations
  isHidden      Boolean  @default(false) // Hide product from public listings
  
  // Detailed product content fields
  productDetails String?  @db.Text // JSON object with key-value pairs for product specs
  keyFeatures    String?  @db.Text // JSON array of features with title and description
  benefits       String?  @db.Text // JSON array of benefits
  ingredients    String?  @db.Text // JSON array of ingredients with name and description
  howToUse       String?  @db.Text // Step-by-step usage instructions
  directions     String?  @db.Text // Detailed directions for use
  
  // Skin recommendation fields
  skinType       String?  // dry, oily, combination, normal, sensitive
  targetConcerns String?  // JSON array of concerns like ["anti-aging", "acne", "hydration"]
  usage          String?  // morning, evening, all-day, morning-evening
  ageGroup       String?  // teen, young-adult, adult, mature
  
  // Rating fields
  rating         Float?   @default(5.0) // Product rating out of 5

  @@index([category]) // Index for faster category filtering
  @@index([isHidden]) // Index for filtering hidden products
  @@index([noDiscount]) // Index for discount exclusion queries
  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerEmail   String
  customerName    String
  customerPhone   String
  customerEmirate String
  customerAddress String
  subtotal        Float
  discountAmount  Float       @default(0)
  shipping        Float       @default(0)
  vat             Float
  total           Float
  status          String      @default("PENDING")
  sessionId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  customer        User        @relation(fields: [customerEmail], references: [email])

  @@index([customerEmail]) // Index for faster order lookups by email
  @@map("orders")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int
  image       String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId]) // Index for faster order item lookups
  @@map("order_items")
}

model PageView {
  id           String   @id @default(cuid())
  page         String
  userId       String?
  userEmail    String?
  userAgent    String?
  ipAddress    String?
  country      String?
  referrer     String?
  timestamp    DateTime @default(now())
  browser      String?
  deviceType   String?
  os           String?
  screenHeight Int?
  screenWidth  Int?
  city         String?

  @@index([timestamp]) // Index for faster analytics queries by time
  @@index([userId]) // Index for user-specific analytics
  @@map("page_views")
}

model UserAction {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  userEmail String?
  details   String?
  timestamp DateTime @default(now())

  @@map("user_actions")
}

model UserSession {
  id           String    @id @default(cuid())
  sessionId    String    @unique
  userId       String?
  userEmail    String?
  ipAddress    String?
  country      String?
  deviceType   String?
  browser      String?
  os           String?
  screenWidth  Int?
  screenHeight Int?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  pageViews    Int       @default(1)
  duration     Int?
  isBounce     Boolean   @default(true)
  referrer     String?

  @@map("user_sessions")
}

model PDFDownload {
  id           String   @id @default(cuid())
  filename     String
  userId       String?
  userEmail    String?
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  deviceType   String?
  browser      String?
  os           String?
  referrer     String?
  timestamp    DateTime @default(now())

  @@map("pdf_downloads")
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   @unique
  count      Int      @default(0)
  resetTime  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("rate_limits")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   // Hashed token (for security)
  expiresAt DateTime // Token expiration time
  used      Boolean  @default(false) // Track if token was already used
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
