generator client {
  provider      = "prisma-client-js"
  // Ensure Prisma client works in serverless environments (Vercel, AWS Lambda, etc.)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  contactEmail       String? // Optional: For Apple Private Relay users to provide real email
  appleSub           String?   @unique
  name               String
  password           String?
  phone              String?
  address            String?   @db.Text // Legacy field - kept for backward compatibility
  profilePicture     String?   @db.Text
  gender             String?
  billingAddress     String?   @db.Text
  vatNumber          String?   @db.Text
  expoPushToken      String?   @db.Text
  isAdmin            Boolean   @default(false)
  canSeePrices       Boolean   @default(true)
  discountType       String?
  discountPercentage Float?
  // Partner consignment agreement (mirrors an active MoySklad Commission
  // contract). When true, the partner may "Add to consignment stock" at
  // checkout. Set by the one-off MoySklad matcher and by admin manually.
  consignmentActive       Boolean @default(false)
  // Partner credit terms (clinics). When active, the partner may place
  // professional-product orders on 30/45/60/90-day payment terms.
  creditActive            Boolean @default(false)
  creditDays              Int? // 30 | 45 | 60 | 90
  // Partner Portal gate — assigned manually by admin. Only accounts with
  // this flag may enter /partner-portal (typically 50%-off clinic accounts).
  partnerPortalAccess     Boolean @default(false)
  moyskladCounterpartyId  String? // MoySklad counterparty UUID (matched by phone)
  moyskladContractId      String? // Active Commission contract UUID
  birthday           String?
  lastLoginAt        DateTime?
  lastLoginSource    String? // Tracks login source: desktop_web, mobile_web, mobile_app
  lastActiveAt       DateTime? // Tracks last user activity for online status
  tokenVersion       Int       @default(0) // Bumped on password change/reset to revoke all sessions/tokens
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Membership / loyalty
  memberNumber  String?   @unique
  memberTier    String    @default("MEMBER") // MEMBER, SILVER, GOLD, PLATINUM
  memberSince   DateTime?
  totalSpent    Float     @default(0)
  totalOrders   Int       @default(0)
  loyaltyPoints Int       @default(0)

  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  reviews             ProductReview[]
  addresses           Address[] // Multiple addresses support
  passkeys            Passkey[] // WebAuthn passkeys for passwordless auth
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

// Auditable ledger of loyalty point movements.
// user.loyaltyPoints is the materialized balance; every change goes through here.
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int // positive = earned, negative = redeemed/adjusted down
  type        String // ORDER_EARN, WELCOME_BONUS, BIRTHDAY_BONUS, BACKFILL, REDEEM, ADJUST
  description String?
  orderId     String? // set for ORDER_EARN / REDEEM; unique per type for idempotency
  createdAt   DateTime @default(now())

  @@unique([orderId, type])
  @@index([userId, createdAt])
  @@map("loyalty_transactions")
}

// WebAuthn Passkeys - enables Face ID/Touch ID authentication
model Passkey {
  id String @id @default(cuid())

  // Link to user
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WebAuthn credential data
  credentialId String @unique @db.Text // Base64url encoded credential ID
  publicKey    String @db.Text // Base64url encoded public key (COSE format)
  counter      BigInt @default(0) // Signature counter for replay attack protection

  // Credential metadata
  transports String? @db.Text // JSON array of transports (usb, nfc, ble, internal, hybrid)

  // Device info (for user management UI)
  deviceType String? // "platform" (built-in) or "cross-platform" (security key)
  deviceName String? // User-friendly name (e.g., "MacBook Pro", "iPhone 15")

  // Backup state (PRF extension)
  backedUp Boolean @default(false) // Whether credential is backed up to iCloud/Google

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // home | work | other
  label        String? // Optional display label (e.g., "My Home", "Office")
  name         String // Recipient full name
  phone        String // Phone number
  addressLine1 String // Street/building
  addressLine2 String? // Apt/unit (optional)
  city         String // City
  emirate      String // Emirate (UAE)
  country      String   @default("United Arab Emirates") // Default to UAE
  isDefault    Boolean  @default(false) // Only one address per user can be default
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// Promotions / announcements shown to users in the app/website.
// Minimal spec: date + text (localized).
model Promotion {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  textEn    String   @db.Text
  textRu    String?  @db.Text
  textAr    String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, date])
  @@map("promotions")
}

model Product {
  id               String   @id @default(cuid())
  productNumber    String?  @unique
  name             String
  nameRu           String?  @db.Text
  nameAr           String?  @db.Text
  price            Float
  description      String   @db.Text
  descriptionRu    String?  @db.Text
  descriptionAr    String?  @db.Text
  image            String
  category         String
  inStock          Boolean  @default(true)
  size             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  images           String?
  videoUrl         String? // Video URL path (e.g., /videos/egf.mp4) – served to mobile app dynamically
  noDiscount       Boolean  @default(false) // Exclude from discount calculations
  isHidden         Boolean  @default(false) // Hide product from public listings
  isPriceOnRequest Boolean  @default(false) // Professional products with price available on request only
  disclaimer       String?  @db.Text // Product disclaimer (e.g., "For professional/clinic use only")

  // Detailed product content fields
  productDetails String? @db.Text // JSON object with key-value pairs for product specs
  keyFeatures    String? @db.Text // JSON array of features with title and description
  benefits       String? @db.Text // JSON array of benefits
  ingredients    String? @db.Text // JSON array of ingredients with name and description
  howToUse       String? @db.Text // Step-by-step usage instructions
  directions     String? @db.Text // Detailed directions for use

  // Skin recommendation fields
  skinType       String? // dry, oily, combination, normal, sensitive
  targetConcerns String? // JSON array of concerns like ["anti-aging", "acne", "hydration"]
  usage          String? // morning, evening, all-day, morning-evening
  ageGroup       String? // teen, young-adult, adult, mature

  // Rating fields
  rating  Float?          @default(5.0) // Product rating out of 5
  reviews ProductReview[]

  // Product variants (sizes, colors with individual pricing)
  variants ProductVariant[]

  @@index([category]) // Index for faster category filtering
  @@index([isHidden]) // Index for filtering hidden products
  @@index([noDiscount]) // Index for discount exclusion queries
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Variant attributes
  size  String? // Size variant (e.g., "50ml", "100ml", "500ml")
  color String? // Color variant (e.g., "Beige", "Ivory", "Natural")

  // Pricing and availability
  price     Float // Variant-specific price
  available Boolean @default(true) // Is this variant in stock?
  isDefault Boolean @default(false) // Default variant to display

  // Stock management (optional for future)
  stockQuantity Int? // Track inventory per variant
  sku           String? // SKU for inventory management

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color]) // One variant per product per size/color combo
  @@index([productId])
  @@index([available])
  @@map("product_variants")
}

model Order {
  id                       String  @id @default(cuid())
  orderNumber              String  @unique
  customerEmail            String
  customerName             String
  customerPhone            String
  customerEmirate          String
  customerAddress          String
  orderNotes               String? @db.Text
  subtotal                 Float
  discountPercentage       Float? // User's discount percentage at time of order
  discountAmount           Float   @default(0)
  bundleDiscountPercentage Float? // Bundle discount percentage (e.g., 20% for 5+ items)
  bundleDiscountAmount     Float   @default(0) // Bundle discount amount in AED
  loyaltyPointsRedeemed    Int     @default(0) // GENOSYS Rewards points spent on this order
  loyaltyDiscountAmount    Float   @default(0) // AED value of redeemed points
  deliveredAt              DateTime? // first transition to DELIVERED (drives review-request timing)
  reviewRequestSentAt      DateTime? // post-delivery review-request email sent (idempotency)
  shipping                 Float   @default(0)
  vat                      Float
  total                    Float
  status                   String  @default("PENDING")
  locale                   String  @default("en") // User's preferred language (en or ar)
  sessionId                String?

  // Payment-related fields
  paymentMethod         String    @default("cod") // cod, stripe, bank_transfer
  paymentStatus         String    @default("pending") // pending, processing, paid, failed, refunded, cancelled
  stripeSessionId       String? // Stripe checkout session ID
  stripePaymentIntentId String? // Stripe payment intent ID
  stripeCustomerId      String? // Stripe customer ID for future payments
  paidAt                DateTime? // When payment was completed
  refundedAt            DateTime? // When refund was processed
  refundAmount          Float? // Amount refunded (can be partial)
  paymentMetadata       String?   @db.Text // JSON metadata from payment provider

  // Partner credit-term orders (paymentMethod partner_credit)
  creditDays     Int? // Credit term length at time of order (30/45/60/90)
  paymentDueDate DateTime? // When payment is due (createdAt + creditDays)

  // MoySklad (accounting system) integration
  moySkladOrderId  String? // MoySklad order UUID after manual push from admin
  moySkladSyncedAt DateTime? // When order was pushed to MoySklad

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  customer  User        @relation(fields: [customerEmail], references: [email])

  @@index([customerEmail]) // Index for faster order lookups by email
  @@index([paymentStatus]) // Index for payment status queries
  @@index([stripeSessionId]) // Index for Stripe session lookups
  @@index([stripePaymentIntentId]) // Index for payment intent lookups
  @@index([status]) // Index for admin order-status filtering
  @@index([createdAt]) // Index for date-range queries and recent-orders sorting
  @@index([status, createdAt]) // Compound for revenue-trends / CLV reports (WHERE status=X AND createdAt>=Y)
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  price          Float
  quantity       Int
  image          String
  color          String? // Product color variant (e.g., "beige", "ivory", "camel")
  size           String? // Product size variant (e.g., "50g", "100g")
  bundleDiscount Float? // Bundle discount % applied to this item (null = not a bundle item)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId]) // Index for faster order item lookups
  @@index([productId]) // product-performance report groupBy + admin product-delete check
  @@map("order_items")
}

model PageView {
  id           String   @id @default(cuid())
  page         String
  userId       String?
  userEmail    String?
  userAgent    String?
  ipAddress    String?
  country      String?
  referrer     String?
  timestamp    DateTime @default(now())
  browser      String?
  deviceType   String?
  os           String?
  screenHeight Int?
  screenWidth  Int?
  city         String?

  @@index([timestamp]) // Index for faster analytics queries by time
  @@index([userId]) // Index for user-specific analytics
  @@map("page_views")
}

model UserAction {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  userEmail String?
  details   String?
  timestamp DateTime @default(now())

  @@index([userEmail, action]) // Index for per-user action lookups in analytics
  @@map("user_actions")
}

model UserSession {
  id           String    @id @default(cuid())
  sessionId    String    @unique
  userId       String?
  userEmail    String?
  ipAddress    String?
  country      String?
  deviceType   String?
  browser      String?
  os           String?
  screenWidth  Int?
  screenHeight Int?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  pageViews    Int       @default(1)
  duration     Int?
  isBounce     Boolean   @default(true)
  referrer     String?

  @@index([userId]) // Index for per-user session lookups in analytics
  @@map("user_sessions")
}

model PDFDownload {
  id         String   @id @default(cuid())
  filename   String
  userId     String?
  userEmail  String?
  ipAddress  String?
  userAgent  String?
  country    String?
  city       String?
  deviceType String?
  browser    String?
  os         String?
  referrer   String?
  timestamp  DateTime @default(now())

  @@map("pdf_downloads")
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   @unique
  count      Int      @default(0)
  resetTime  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("rate_limits")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String // Hashed token (for security)
  expiresAt DateTime // Token expiration time
  used      Boolean  @default(false) // Track if token was already used
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.Text
  content       String        @db.Text
  featuredImage String?
  authorId      String?
  authorName    String? // Store author name for display
  published     Boolean       @default(false)
  publishedAt   DateTime?
  views         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      BlogComment[]
  tags          String? // JSON array of tags
  // Arabic translations
  titleAr       String?       @db.Text
  excerptAr     String?       @db.Text
  contentAr     String?       @db.Text
  // Russian translations
  titleRu       String?       @db.Text
  excerptRu     String?       @db.Text
  contentRu     String?       @db.Text

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
  @@map("blog_posts")
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String? // Nullable for guest comments (if needed in future)
  userName  String // User's name
  userEmail String? // User's email (optional)
  content   String   @db.Text
  approved  Boolean  @default(true) // Auto-approve for registered users
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([approved])
  @@index([createdAt])
  @@map("blog_comments")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String // Required - only registered users can review
  userName  String // User's name at time of review
  userEmail String // User's email
  rating    Int // 1-5 stars
  title     String? // Optional review title
  comment   String   @db.Text // Review text
  approved  Boolean  @default(true) // Auto-approve for registered users
  helpful   Int      @default(0) // Helpful votes count
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // One review per user per product
  @@index([productId])
  @@index([userId])
  @@index([approved])
  @@index([createdAt])
  @@index([rating])
  @@map("product_reviews")
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique // Promo code (e.g., "WELCOME20", "QR20")
  discountType    String // Type identifier (e.g., "QR_SIGNUP", "REFERRAL", "EVENT")
  discountPercent Float // Discount percentage (e.g., 20.0 for 20%)
  isActive        Boolean   @default(true) // Can be used?
  expiresAt       DateTime? // Optional expiration date
  maxUses         Int? // Maximum number of uses (null = unlimited)
  usedCount       Int       @default(0) // How many times used
  description     String?   @db.Text // Description of promo (for admin reference)
  createdBy       String? // Admin user who created it
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("promo_codes")
}

// PWA Web Push Subscriptions - stores push subscription details for each user
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String // User who subscribed
  endpoint  String   @unique @db.Text // Push service endpoint URL
  p256dh    String   @db.Text // Public key for encryption
  auth      String // Authentication secret
  userAgent String?  @db.Text // Browser/device info
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

// PWA Notifications - sent from admin to PWA users
model PWANotification {
  id          String   @id @default(cuid())
  promotionId String? // Optional link to promotion (for reusing promo content)
  title       String // Notification title
  titleRu     String? // Russian title
  titleAr     String? // Arabic title
  body        String   @db.Text // Notification body
  bodyRu      String?  @db.Text // Russian body
  bodyAr      String?  @db.Text // Arabic body
  url         String? // URL to open when notification is clicked
  sentAt      DateTime @default(now())
  sentBy      String? // Admin email who sent it
  totalSent   Int      @default(0) // Number of push notifications sent
  createdAt   DateTime @default(now())

  reads NotificationRead[]

  @@index([sentAt])
  @@map("pwa_notifications")
}

// Track which users have read which notifications (for badge counting)
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification PWANotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId]) // One read record per user per notification
  @@index([userId])
  @@index([notificationId])
  @@map("notification_reads")
}

// Chatbot Analytics - tracks conversations and messages for admin insights
model ChatConversation {
  id        String  @id @default(cuid())
  sessionId String // Chat session ID (unique per conversation)
  userId    String? // User ID if logged in
  userEmail String? // User email if available
  locale    String  @default("en") // User's language preference

  // Conversation metrics
  messageCount Int @default(0) // Total messages in conversation
  userMessages Int @default(0) // Messages from user
  botMessages  Int @default(0) // Messages from bot

  // Topics/keywords (JSON array of detected topics)
  topics String? @db.Text // e.g., ["skincare", "products", "delivery"]

  // First user message (for quick preview in admin)
  firstMessage String? @db.Text

  // Device/location info
  ipAddress  String?
  country    String?
  city       String?
  userAgent  String? @db.Text
  deviceType String? // mobile, desktop, tablet
  browser    String?

  // Timestamps
  startedAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  endedAt       DateTime? // When conversation ended (if detectable)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId])
  @@index([startedAt])
  @@index([locale])
  @@index([userId])
  @@index([lastMessageAt])
  @@map("chat_conversations")
}

// Skin Analysis - stores user skin analysis results with photos
model SkinAnalysis {
  id     String  @id @default(cuid())
  userId String? // Optional - can be used by guests

  // Captured image (stored as base64 data URL or cloud storage URL)
  imageUrl String? @db.Text

  // Primary results
  skinType   String // dry, oily, combination, normal, sensitive
  confidence Int // 0-100

  // Detailed metrics (0-100)
  oilinessLevel  Int
  hydrationLevel Int
  rednessLevel   Int
  textureScore   Int // smoothness
  evennessScore  Int // color uniformity
  tZoneOiliness  Int
  cheekHydration Int

  // Skin characteristics
  skinTone         String // fair, light, medium, tan, deep
  undertone        String // warm, cool, neutral
  poreVisibility   String // minimal, moderate, visible
  estimatedSkinAge Int

  // Detected concerns (JSON array)
  concerns String @db.Text // JSON array: ["hydration", "anti-aging", ...]

  // Generated recommendations (JSON array)
  recommendations String @db.Text // JSON array of strings

  // Age group derived from analysis
  ageGroup String? // teen, young-adult, adult, mature

  // Analysis quality
  lightingQuality String // poor, fair, good, excellent

  // Metadata
  deviceInfo String? @db.Text // User agent / device info
  locale     String? // Language used during analysis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([skinType])
  @@map("skin_analyses")
}

// FAQ Items - stores frequently asked questions with multilingual support
model FaqItem {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  category  String?

  // English (required)
  questionEn String
  answerEn   String @db.Text

  // Arabic (optional)
  questionAr String?
  answerAr   String? @db.Text

  // Russian (optional)
  questionRu String?
  answerRu   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("faq_items")
}

// Newsletter subscribers — captured from homepage/footer forms.
// Separate from User so guests can subscribe; token drives one-click unsubscribe.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("en") // en | ar | ru — for localized campaigns
  source           String    @default("homepage") // homepage | footer | checkout | admin | import
  isActive         Boolean   @default(true)
  unsubscribeToken String    @unique
  userId           String? // Optional link to a registered User (same email)
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  lastSentAt       DateTime?
  ipAddress        String?
  userAgent        String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([locale, isActive])
  @@index([email])
  @@map("newsletter_subscribers")
}

// Newsletter campaigns — audit log for every send (test and production).
// Status transitions: draft → sending → sent | failed
model NewsletterCampaign {
  id              String    @id @default(cuid())
  subject         String
  bodyMarkdown    String    @db.Text // raw markdown from composer
  bodyHtml        String    @db.Text // rendered HTML snippet (inside branded wrapper)
  localeFilter    String? // null = all locales, else en|ar|ru
  sourceFilter    String? // optional subscriber.source filter
  isTest          Boolean   @default(false)
  testEmail       String? // recipient for a test send
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  status          String    @default("draft") // draft | sending | sent | failed | cancelled
  sentByEmail     String // admin who triggered the send
  startedAt       DateTime?
  completedAt     DateTime?
  errors          String?   @db.Text // JSON array of { email, error }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("newsletter_campaigns")
}
