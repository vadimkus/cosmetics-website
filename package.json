{
  "name": "cosmetics-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npx prisma generate && node scripts/deploy-setup.js && node scripts/generate-sw-version.js && next build",
    "build:analyze": "ANALYZE=true node scripts/deploy-setup.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "PRISMA_CONFIG_PATH=./prisma.config.ts npx prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate-password-reset": "node scripts/migrate-password-reset-table.js",
    "db:add-payment-fields": "npx tsx scripts/add-payment-fields-to-orders.ts",
    "translate:products": "npx tsx scripts/translate-products-to-russian.ts",
    "asset:face-glb": "blender -b --python scripts/build-photoreal-face-hero-glb.py && gltf-transform optimize public/models/desktop-experience/genosys-athlete-face-hero-real.glb public/models/desktop-experience/genosys-athlete-face-hero-real-optimized.glb --compress false --texture-compress false --texture-size 2048 --simplify true --simplify-ratio 0.92 --simplify-error 0.00002",
    "deploy:setup": "node scripts/deploy-setup.js",
    "sentry:errors": "node scripts/sentry-errors.js",
    "smoke:pricing-contract": "npx tsx scripts/smoke-pricing-contract.ts",
    "vercel:logs": "vercel logs --since=1h --environment=production --limit=100",
    "vercel:logs:errors": "vercel logs --since=24h --environment=production --level=error --limit=100",
    "vercel:logs:follow": "vercel logs --follow --environment=production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/react": "^3.0.206",
    "@google-cloud/translate": "^9.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-oauth/google": "^0.12.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.57.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tailwindcss/postcss": "^4.3.1",
    "ai": "^6.0.204",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^5.0.0",
    "framer-motion": "^12.40.0",
    "google-auth-library": "^10.7.0",
    "lucide-react": "^0.543.0",
    "next": "^16.2.9",
    "next-intl": "^4.5.5",
    "nodemailer": "^8.0.11",
    "openai": "^6.42.0",
    "pdfjs-dist": "^4.4.168",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-pdf": "^10.3.0",
    "stripe": "^22.2.2",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@gltf-transform/cli": "^4.4.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "baseline-browser-mapping": "^2.10.37",
    "cssnano": "^7.1.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^27.1.0",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tar": "^7.5.16",
    "@hono/node-server": "1.19.13",
    "postcss": "$postcss"
  }
}
