# ============================================
# Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ============================================
# REQUIRED VARIABLES
# ============================================

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/genosys_db

# Environment
# Options: development, production, test
NODE_ENV=development

# ============================================
# OPTIONAL - Database
# ============================================

# Prisma Accelerate Connection String (optional)
# Used for faster database queries in production
# Format: prisma://accelerate-url
PRISMA_DATABASE_URL=

# ============================================
# OPTIONAL - Admin Configuration
# ============================================

# Admin user email (defaults to admin@genosys.ae if not set)
ADMIN_EMAIL=admin@genosys.ae

# Admin user password (defaults to admin5 if not set)
# IMPORTANT: Change this in production!
ADMIN_PASSWORD=admin5

# Admin user name (defaults to "Admin User" if not set)
ADMIN_NAME=Admin User

# ============================================
# OPTIONAL - Email Configuration (Gmail)
# ============================================

# Gmail address for sending emails
# Used by lib/email.ts for Gmail SMTP
GMAIL_USER=your_email@gmail.com

# Gmail App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password

# ============================================
# OPTIONAL - Email Configuration (SMTP)
# ============================================

# SMTP server hostname (defaults to mail.genosys.ae)
SMTP_HOST=mail.genosys.ae

# SMTP server port (defaults to 587)
SMTP_PORT=587

# SMTP username (defaults to hello@genosys.ae)
SMTP_USER=hello@genosys.ae

# SMTP password
SMTP_PASS=your_smtp_password

# Alternative email password variable
EMAIL_PASSWORD=your_email_password

# Alternative email user variable
EMAIL_USER=your_email_user

# ============================================
# OPTIONAL - Application URLs
# ============================================

# Public site URL (used in email templates and links)
# Defaults to http://localhost:3000 in development, https://genosys.ae in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL (used for SEO and structured data)
# Defaults to https://genosys.ae
NEXT_PUBLIC_BASE_URL=https://genosys.ae

# Base URL for scripts and testing (defaults to http://localhost:3000)
BASE_URL=http://localhost:3000

# Test URL for test scripts (defaults to http://localhost:3000)
TEST_URL=http://localhost:3000

# ============================================
# OPTIONAL - CDN Configuration
# ============================================

# CDN URL for static assets
CDN_URL=

# Public CDN URL (alternative to CDN_URL)
NEXT_PUBLIC_CDN_URL=

# CDN Provider (cloudflare, cloudfront, vercel, or custom)
CDN_PROVIDER=

# ============================================
# OPTIONAL - Development & Debugging
# ============================================

# Enable debug logging (true/false)
# Defaults to true in development mode
DEBUG_LOG=true

# Enable bundle analyzer (true/false)
# Used with: npm run build:analyze
ANALYZE=false

# Vercel environment (automatically set by Vercel)
VERCEL_ENV=

# ============================================
# NOTES
# ============================================
#
# 1. For Gmail:
#    - Use Gmail App Password, not your regular password
#    - Generate at: https://myaccount.google.com/apppasswords
#    - Enable 2FA on your Google account first
#
# 2. For Production:
#    - Set NODE_ENV=production
#    - Set secure ADMIN_EMAIL and ADMIN_PASSWORD
#    - Use HTTPS URLs for NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_BASE_URL
#    - Consider using PRISMA_DATABASE_URL for better performance
#
# 3. Security:
#    - Never commit .env.local to version control
#    - Use strong passwords in production
#    - Rotate credentials regularly
#    - Use environment-specific values for each deployment
#
# 4. Database:
#    - DATABASE_URL is required for the application to start
#    - PRISMA_DATABASE_URL is optional but recommended for production
#    - Both should be valid PostgreSQL connection strings
#
# 5. Email:
#    - Either Gmail (GMAIL_USER + GMAIL_APP_PASSWORD) or SMTP (SMTP_*) can be used
#    - Gmail is simpler but has sending limits
#    - SMTP gives more control and higher limits
