# GENOSYS Middle East FZ-LLC - Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ============================================
# REQUIRED - Database Configuration
# ============================================
# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/genosys?schema=public"

# Optional: Alternative Prisma database URL (if different from DATABASE_URL)
# PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/genosys?schema=public"

# ============================================
# REQUIRED - Email Configuration (Gmail)
# ============================================
# Gmail address for sending emails (e.g., noreply@genosys.ae)
GMAIL_USER="your-email@gmail.com"

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="your-app-password-here"

# ============================================
# REQUIRED - Admin Configuration
# ============================================
# Admin email address (receives order notifications, user registrations, etc.)
ADMIN_EMAIL="admin@genosys.ae"

# Admin password (will be hashed with bcrypt on first use)
# Change this immediately in production!
ADMIN_PASSWORD="change-this-password"

# Optional: Admin display name
ADMIN_NAME="Admin User"

# ============================================
# REQUIRED - Application Configuration
# ============================================
# Node environment: development, staging, or production
NODE_ENV="development"

# Base URL of your application (used in emails, links, etc.)
# Development: http://localhost:3000
# Production: https://genosys.ae
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Base URL for API calls (defaults to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: API URL (if different from base URL)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ============================================
# OPTIONAL - Debug & Development
# ============================================
# Enable debug logging (true/false)
# In development, this defaults to true
DEBUG_LOG="true"

# ============================================
# OPTIONAL - Analytics & Monitoring
# ============================================
# Google Analytics ID (if using GA)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- Sentry (error + perf monitoring) ---
# Both env vars should be set to the SAME DSN value from your Sentry project.
# Without these, Sentry.init is a silent no-op and no events ship (safe default).
# - NEXT_PUBLIC_SENTRY_DSN is required; exposed to the browser (DSNs are non-secret).
# - SENTRY_DSN is optional; if unset the server falls back to the NEXT_PUBLIC one.
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
#
# Only needed at build time for uploading source maps (readable stack traces):
# SENTRY_ORG="genosys-middle-east-fz-llc"
# SENTRY_PROJECT="javascript-nextjs"
# SENTRY_AUTH_TOKEN="sntrys_..."
#
# SENTRY_AUTH_TOKEN is also used by `npm run sentry:errors` to pull issues
# from the API. Create a Personal Auth Token at
# https://sentry.io/settings/account/api/auth-tokens/ with scopes:
#   project:read, event:read
#
# Set to "true" to capture events during local `next dev` runs (default: off).
# SENTRY_ENABLE_DEV="false"

# ============================================
# OPTIONAL - Build Configuration
# ============================================
# Enable bundle analyzer (true/false)
# ANALYZE="false"

# ============================================
# OPTIONAL - Migration & Security
# ============================================
# Secret key for migration endpoints (if using migration API)
# MIGRATION_SECRET="your-secret-key-here"

# ============================================
# OPTIONAL - AI Chatbot (OpenAI)
# ============================================
# OpenAI API key for AI chatbot functionality
# Get your API key from: https://platform.openai.com/api-keys
# The chatbot will be disabled if this is not set
OPENAI_API_KEY="sk-your-api-key-here"

# ============================================
# OPTIONAL - MoySklad (МойСклад) Accounting Integration
# ============================================
# MoySklad login email (for API authentication)
# Orders placed on genosys.ae will be automatically created in MoySklad
# MOYSKLAD_LOGIN="your-moysklad-email@example.com"
# MOYSKLAD_PASSWORD="your-moysklad-password"

# ============================================
# NOTES
# ============================================
# 1. All environment variables starting with NEXT_PUBLIC_ are exposed to the browser
# 2. Never commit actual credentials to version control
# 3. In production, set these via your hosting platform's environment variable settings
# 4. For Vercel: Set environment variables in the Vercel dashboard under Project Settings > Environment Variables
# 5. Database URL format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
# 6. Gmail App Password: Must be generated from Google Account settings, not your regular password
