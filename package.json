  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-setup.js && next build",
    "build:analyze": "ANALYZE=true node scripts/deploy-setup.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/deploy-setup.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "deploy:setup": "node scripts/deploy-setup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@sentry/nextjs": "^8.45.0",
    "@types/nodemailer": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "logrocket": "^4.0.0",
    "lucide-react": "^0.543.0",
    "next": "^15.5.2",
    "nodemailer": "^7.0.6",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^14.25.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^5.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^15.5.3",
    "@types/node": "^20.19.13",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "cssnano": "^7.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.32",
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
