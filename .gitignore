# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# log files
logs/
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# User data storage (contains sensitive information)
/data/
