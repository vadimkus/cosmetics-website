{
  "name": "cosmetics-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npx prisma generate && node scripts/deploy-setup.js && node scripts/generate-sw-version.js && next build",
    "build:analyze": "ANALYZE=true node scripts/deploy-setup.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "PRISMA_CONFIG_PATH=./prisma.config.ts npx prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate-password-reset": "node scripts/migrate-password-reset-table.js",
    "db:add-payment-fields": "npx tsx scripts/add-payment-fields-to-orders.ts",
    "translate:products": "npx tsx scripts/translate-products-to-russian.ts",
    "deploy:setup": "node scripts/deploy-setup.js",
    "sentry:errors": "node scripts/sentry-errors.js",
    "vercel:logs": "vercel logs https://genosys.ae --since=1h",
    "vercel:logs:follow": "vercel logs https://genosys.ae --follow",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/react": "^3.0.70",
    "@google-cloud/translate": "^9.3.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.3.0",
    "@react-oauth/google": "^0.12.2",
    "@sentry/nextjs": "^10.22.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/nodemailer": "^7.0.1",
    "ai": "^6.0.68",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^5.0.0",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.543.0",
    "next": "^16.2.3",
    "next-intl": "^4.5.5",
    "nodemailer": "^7.0.6",
    "openai": "^6.17.0",
    "pdfjs-dist": "^4.4.168",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-pdf": "^10.3.0",
    "stripe": "^19.0.0",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "twilio": "^5.11.2",
    "web-push": "^3.6.7",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.2.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "baseline-browser-mapping": "^2.8.32",
    "cssnano": "^7.1.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.3",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
