    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jest-environment-jsdom": "^30.2.0",
    "prisma": "^6.17.0",
    "typescript": "^5.9.3"
  }
